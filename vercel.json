{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "web-toppay.in" }],
      "destination": "https://www.web-toppay.in/$1",
      "permanent": true
    },
    { "source": "/login", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/portal.html", "destination": "/", "permanent": true },
    { "source": "/toppay-guide", "destination": "/toppay-guide.html", "permanent": true },
    { "source": "/toppay-real-or-fake", "destination": "/toppay-real-or-fake.html", "permanent": true },
    { "source": "/toppay-app-download", "destination": "/toppay-app-download.html", "permanent": true },
    { "source": "/toppay-withdrawal", "destination": "/toppay-withdrawal.html", "permanent": true },
    { "source": "/usdt-to-inr", "destination": "/usdt-to-inr.html", "permanent": true },
    { "source": "/toppay-customer-care", "destination": "/toppay-customer-care.html", "permanent": true },
    { "source": "/toppay-hindi", "destination": "/toppay-hindi.html", "permanent": true },
    { "source": "/toppay-apk", "destination": "/toppay-apk.html", "permanent": true },
    { "source": "/toppay-usdt", "destination": "/toppay-usdt.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/user-app/pages/login.html" },
    { "source": "/home", "destination": "/user-app/pages/home.html" },
    { "source": "/admin", "destination": "/admin-app/pages/login.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://kxsgjfvtfmbruddeolbt.supabase.co https://*.supabase.co; media-src 'self' https:; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
